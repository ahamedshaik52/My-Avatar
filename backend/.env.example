# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=My Avatar API
ENVIRONMENT=development
DEBUG=true

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/myavatar

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Storage ──────────────────────────────────────────────────────────────────
# Options: "local" (dev) | "s3" (production)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./media

# S3 (only needed when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── AI Services ──────────────────────────────────────────────────────────────
# ElevenLabs TTS (https://elevenlabs.io)
ELEVENLABS_API_KEY=

# D-ID Lip Sync (https://www.d-id.com)
D_ID_API_KEY=

# SadTalker local model path (alternative to D-ID)
SADTALKER_MODEL_PATH=./models/sadtalker

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ─── Frontend URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email ────────────────────────────────────────────────────────────────────
# EMAIL_BACKEND=console  → prints reset links to API stdout (default, great for dev)
# EMAIL_BACKEND=smtp     → sends real email; fill in SMTP_* below
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=noreply@myavatar.ai
EMAIL_FROM_NAME=My Avatar

# SMTP (only needed when EMAIL_BACKEND=smtp)
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USE_TLS=true
# Mailgun:       SMTP_HOST=smtp.mailgun.org SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
